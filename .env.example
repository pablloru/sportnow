# Copy this file to .env.local and fill in real values when connecting
# real integrations. Nothing here is required to run V1 — the app runs
# entirely on mock data (see src/lib/mock-data) until these are set and
# src/lib/repositories/*.ts are updated to call src/lib/integrations/*.

# Public site URL — used for canonical URLs, sitemap.xml and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Future external integrations (not used yet):
# SPORTS_API_KEY=
# NEWS_API_KEY=
# ODDS_API_KEY=
